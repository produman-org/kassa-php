{
    "name": "produman-org/kassa-php",
    "description": "PHP library for the Produman.Kassa API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "produman",
        "kassa",
        "api"
    ],
    "authors": [
        {
            "name": "Produman",
            "email": "kassa@produman.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "psr/log": "^1|^2|^3",
        "symfony/http-client": "^5.4|^6.0|^7.0|^8.0",
        "symfony/http-client-contracts": "^2.5.4|^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ProdumanApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProdumanApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php -d error_reporting=-1 vendor/bin/phpunit",
        "test:integration": "@php -d error_reporting=-1 vendor/bin/phpunit --group integration",
        "test:consumer": "@php tools/check-consumer.php",
        "test:lowest": "@php tools/check-consumer.php --prefer-lowest --run-tests"
    }
}
